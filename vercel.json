{
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/projects/:slug.html"
    },
    {
      "source": "/:path",
      "destination": "/:path.html"
    }
  ]
}
